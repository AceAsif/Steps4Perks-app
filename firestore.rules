rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /dailyStats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /redeemed_rewards/{rewardId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        // Users cannot edit or delete redemption history (audit trail)
        allow update, delete: if false;
      }
    }

    // Rewards catalogue is read-only for signed-in users;
    // only manageable from the Firebase console / Admin SDK
    match /rewards_catalogue/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
